# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,密码中的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
OPENLIST_TAG=v4.2.4
POSTGRES_TAG=16-alpine
# init 服务用它把数据目录属主改成 openlist 用户(自动 chown,免手动)
BUSYBOX_TAG=1.37.0

# ---- 基础 ----
TZ=Asia/Shanghai
# 对外访问地址,填反代后的完整域名(带协议);本地测试可留空
SITE_URL=https://openlist.example.com

# ---- 容器运行用户(v4.1.0 起容器非 root 运行,默认 1001:1001) ----
# 需保证宿主 ./data/openlist 属主与此一致,详见 readme「数据目录权限」
OPENLIST_UID=1001
OPENLIST_GID=1001

# ---- PostgreSQL(首次启动自动建库;OpenList 用它替代默认 sqlite) ----
POSTGRES_DB=openlist
POSTGRES_USER=openlist
# 只用字母数字,避开 compose 插值 / URL 编码的坑;生成:openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
