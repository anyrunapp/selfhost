# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,值中的字面 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
RUSTDESK_TAG=1.1.14

# ---- 基础 ----
TZ=Asia/Shanghai

# ---- 端口绑定地址 ----
# 默认只绑回环 127.0.0.1(符合仓库“仅本机 + 前置代理”约定)。
# RustDesk 客户端需要直连 TCP/UDP,普通 HTTP 反代无法转发;
# 对公网提供服务时改成 0.0.0.0(并在防火墙放行对应端口),
# 或用四层(TCP/UDP)转发把公网端口映射到这里,且务必保持端口“连续同序”。
BIND_ADDR=127.0.0.1

# ---- hbbs / hbbr 额外启动参数(可留空) ----
# 当宿主端口与容器端口不一致(如经四层代理改了端口),需要用 -r 告知客户端真实中继地址:
#   RUSTDESK_HBBS_OPTS=-r your.public.ip:21117
# 其它常用:-k _ 强制校验公钥(推荐)。示例:
#   RUSTDESK_HBBS_OPTS=-r your.public.ip:21117 -k _
RUSTDESK_HBBS_OPTS=
RUSTDESK_HBBR_OPTS=
