# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,密码中的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
POSTGRES_TAG=17.10-alpine

# ---- 基础 ----
# 容器时区,影响日志时间戳
TZ=Asia/Shanghai
# 数据库内部时区(now() 等),与 TZ 对齐
PG_TIMEZONE=Asia/Shanghai
# 连接数上限
PG_MAX_CONNECTIONS=100

# ---- 数据库(首次启动会自动建库 + 业务账号) ----
# 业务库名
POSTGRES_DB=appname
# 业务账号(也是该库 owner;应用连接用这个)
POSTGRES_USER=appname

# 密码只用字母数字,避开 compose 插值 / URL 编码的坑;生成:openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
