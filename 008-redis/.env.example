# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,密码中的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
REDIS_TAG=7.4.2-alpine

# ---- 基础 ----
TZ=Asia/Shanghai

# ---- 内存 / 淘汰 ----
# 内存上限(到顶后按策略淘汰);按宿主内存调,如 256mb / 1gb
REDIS_MAXMEMORY=256mb
# 淘汰策略:纯缓存用 allkeys-lru;当队列/存重要数据用 noeviction(写满即报错,不丢数据)
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---- 认证 ----
# 密码只用字母数字,避开 compose 插值 / URL 编码的坑;生成:openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME
