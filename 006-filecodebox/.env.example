# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,值里的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
FILECODEBOX_TAG=2.5.4

# ---- 基础 ----
TZ=Asia/Shanghai
# uvicorn worker 数
WORKERS=1
# 日志级别:critical/error/warning/info/debug/trace
LOG_LEVEL=info
# 反代可信来源:前面挂反代时填代理网段(逗号分隔),否则留空只信直连 IP
# 例:FORWARDED_ALLOW_IPS=172.16.0.0/12
FORWARDED_ALLOW_IPS=
