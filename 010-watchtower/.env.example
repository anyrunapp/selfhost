# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
WATCHTOWER_TAG=1.7.1

# ---- 基础 ----
TZ=Asia/Shanghai
# 显式指定 docker API 版本(watchtower 1.7.1 内置客户端默认太旧,新版 daemon 会拒)
# 取你 daemon 支持的值:docker version --format '{{.Server.APIVersion}}'
DOCKER_API_VERSION=1.44

# ---- 检查计划(6 段 cron:秒 分 时 日 月 周)----
# 默认每天 04:00 检查一次;每 6 小时 = "0 0 */6 * * *"
WATCHTOWER_SCHEDULE=0 0 4 * * *

# ---- 可选:指标 API token(仅启用 WATCHTOWER_HTTP_API_METRICS 时用)----
# 字母数字即可:openssl rand -hex 24
# WATCHTOWER_API_TOKEN=CHANGE_ME

# ---- 可选:通知(shoutrrr URL),例如 telegram://token@telegram?chats=id ----
# WATCHTOWER_NOTIFICATION_URL=
