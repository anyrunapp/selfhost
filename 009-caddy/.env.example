# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:Caddy 走 host 网络、直接绑 80/443,不使用 ${PORT_x}(那组端口对本应用是保留未用)。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
CADDY_TAG=2.10.2-alpine

# ---- 基础 ----
TZ=Asia/Shanghai

# ---- ACME / 证书 ----
# 你的邮箱:证书快过期时 Let's Encrypt 会邮件提醒;留默认也能签,但建议填真实邮箱
ACME_EMAIL=you@example.com
