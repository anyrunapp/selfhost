# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,密码中的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
MEMOS_TAG=0.30.0
POSTGRES_TAG=16-alpine

# ---- 基础 ----
TZ=Asia/Shanghai
# 对外访问地址,填反代后的完整域名(带协议);本地测试可留空
MEMOS_INSTANCE_URL=https://memos.example.com

# ---- 容器运行用户(entrypoint 以 root 起、修完权限后降到该 UID/GID) ----
MEMOS_UID=10001
MEMOS_GID=10001

# ---- PostgreSQL(首次启动自动建库;Memos 用它替代默认 sqlite) ----
POSTGRES_DB=memos
POSTGRES_USER=memos
# 只用字母数字:密码会拼进 DSN URL,含特殊字符要 URL 编码,直接避开;生成:openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
