# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,密码中的 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
MYSQL_TAG=8.0.46

# ---- 基础 ----
# 容器时区,影响日志时间戳
TZ=Asia/Shanghai

# ---- 数据库(首次启动会自动建库 + 业务账号) ----
# 业务库名
MYSQL_DATABASE=appname
# 业务账号(应用连接用这个,不要用 root)
MYSQL_USER=appname

# 密码只用字母数字,避开 compose 插值 / URL 编码的坑;生成:openssl rand -hex 24
# root 密码(仅本机维护 / 备份用)
MYSQL_ROOT_PASSWORD=CHANGE_ME1
# 业务账号密码
MYSQL_PASSWORD=CHANGE_ME2
