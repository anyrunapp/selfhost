# 复制为 .env 后修改。PORT_* / APP_* 由 bin/ports.sh --write 自动生成,不要手写。
# 注意:.env 里的值会被 compose 做 ${} 插值,值中的字面 $ 要写成 $$。

# ---- 镜像版本(锁定具体版本,不要用 latest) ----
RUSTDESK_TAG=1.1.14

# ---- 基础 ----
TZ=Asia/Shanghai

# ---- 端口绑定地址 ----
# 默认只绑回环 127.0.0.1(符合仓库“仅本机 + 前置代理”约定)。
# RustDesk 客户端需要直连 TCP/UDP,普通 HTTP 反代无法转发;
# 对公网提供服务时改成 0.0.0.0(并在防火墙放行 21115-21119 TCP + 21116 UDP)。
# 前缀 111 已让端口段(21110-21119)与 RustDesk 原生端口对齐,宿主口=容器口,无需改端口。
BIND_ADDR=127.0.0.1

# ---- hbbs / hbbr 额外启动参数(可留空) ----
# 宿主口=容器口,默认无需 -r。若强制客户端校验公钥可加 -k _(推荐,防中间人):
#   RUSTDESK_HBBS_OPTS=-k _
RUSTDESK_HBBS_OPTS=
RUSTDESK_HBBR_OPTS=
